# =================================================================
# VARIÁVEIS DO FRONTEND (Next.js - Vercel)
# =================================================================
# ATENÇÃO: Na Vercel, defina essas variáveis nas configurações do projeto.
NEXT_PUBLIC_SUPABASE_URL=https://<seu-projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<sua-chave-anonima>
NEXT_PUBLIC_API_URL=https://api.notaa.com.br

# =================================================================
# VARIÁVEIS DO BACKEND (NestJS - Render/Railway)
# =================================================================
# ATENÇÃO: NUNCA coloque NEXT_PUBLIC no backend. Defina essas variáveis no seu host.
SUPABASE_URL=https://<seu-projeto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<sua-chave-secreta-service-role>
SUPABASE_JWT_SECRET=<seu-jwt-secret>
DATABASE_URL=postgresql://postgres.<seu-projeto>:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
PORT=8080
ENABLE_DEV_AUTH_BYPASS=false
LLM_PROVIDER=gemini # (ou outro provedor configurado)
LLM_API_KEY=<sua-chave-api>
LLM_MODEL_SOCRATICA=gemini-1.5-pro
LLM_MODEL_REDACAO=gemini-1.5-pro
# Google Gemini (GeminiAdapter / rota /ai/test). Definir na Vercel do projeto da API.
GEMINI_API_KEY=<sua-chave-gemini>
GEMINI_MODEL=gemini-2.0-flash
SENTRY_DSN=<opcional>
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=86400000
