# =================================================================
# VARIÁVEIS DO FRONTEND (Next.js - Vercel)
# =================================================================
# ATENÇÃO: Na Vercel, defina essas variáveis nas configurações do projeto.
NEXT_PUBLIC_SUPABASE_URL=https://<seu-projeto>.supabase.co   # USADA — lib/supabase-browser.ts
NEXT_PUBLIC_SUPABASE_ANON_KEY=<sua-chave-anonima>            # USADA — lib/supabase-browser.ts
NEXT_PUBLIC_API_URL=https://api.notaa.com.br                 # USADA — lib/api-client.ts

# =================================================================
# VARIÁVEIS DO BACKEND (NestJS - Vercel / ambiente da API)
# =================================================================
# ATENÇÃO: NUNCA coloque NEXT_PUBLIC no backend. Defina essas variáveis no host da API.
SUPABASE_URL=https://<seu-projeto>.supabase.co               # USADA — auth.module.ts, verify-jwt.ts
SUPABASE_SERVICE_ROLE_KEY=<sua-chave-secreta-service-role>   # USADA — auth.module.ts
SUPABASE_JWT_SECRET=<seu-jwt-secret>                         # USADA — auth.guard.ts, auth.controller.ts
DATABASE_URL=postgresql://postgres.<seu-projeto>:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres  # USADA — db.module.ts
# PORT só é necessário no desenvolvimento local (a Vercel injeta a porta da function).
PORT=8080
ENABLE_DEV_AUTH_BYPASS=false                                 # USADA — common/dev-user.ts
# Google Gemini (GeminiAdapter; rota de diagnóstico /ai/test é admin-only). Definir na Vercel do projeto da API.
GEMINI_API_KEY=<sua-chave-gemini>                            # USADA — gemini.adapter.ts, ai.controller.ts
GEMINI_MODEL=gemini-3.1-flash-lite                           # USADA — gemini.adapter.ts, ai.controller.ts (default)
SENTRY_DSN=<opcional>                                        # USADA — common/sentry.ts
LOG_LEVEL=info                                               # NÃO USADA — não é lida em nenhum lugar do código
RATE_LIMIT_WINDOW_MS=86400000                                # NÃO USADA — o rate-limiter.interceptor não lê env (limites são por metadata/código)
