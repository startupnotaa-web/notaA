{
  "name": "@notaa/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "ts-node src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "vercel-build": "pnpm --filter @notaa/contracts --filter @notaa/db --filter @notaa/engine-tri --filter @notaa/engine-profiler --filter @notaa/engine-error-detector build && tsc -p tsconfig.vercel.json && node scripts/bundle.mjs",
    "start": "node dist/main.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-fastify": "^10.4.15",
    "@notaa/contracts": "workspace:*",
    "@notaa/db": "workspace:*",
    "@notaa/engine-error-detector": "workspace:*",
    "@notaa/engine-profiler": "workspace:*",
    "@notaa/engine-tri": "workspace:*",
    "@supabase/supabase-js": "^2.47.10",
    "dotenv": "^16.4.7",
    "fastify": "^4.28.1",
    "jose": "^5.9.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "serverless-http": "^4.0.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@swc/core": "^1.10.1",
    "@types/supertest": "^6.0.2",
    "esbuild": "^0.28.1",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.8"
  }
}
