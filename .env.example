# ── apps/web (público, prefixo NEXT_PUBLIC_ é exposto ao cliente) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── apps/api e apps/worker (NUNCA expor ao cliente) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=
PORT=3001
# Dev/local ONLY — habilita o bypass de auth (header x-development-mode) como o
# usuário mock. FAIL-CLOSED: sem este flag, nenhum ambiente autentica sem token.
# NUNCA defina em produção/staging/preview.
ENABLE_DEV_AUTH_BYPASS=false

# Provedor de IA (porta LLMProvider — trocável, ver docs/06)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL_SOCRATICA=
LLM_MODEL_REDACAO=

# Google Gemini (GeminiAdapter — usado na rota /ai/test; futuro provedor padrão)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Observabilidade
SENTRY_DSN=
LOG_LEVEL=info

# Rate limiter / planos (defaults de desenvolvimento — calibrar por plano)
RATE_LIMIT_WINDOW_MS=86400000
